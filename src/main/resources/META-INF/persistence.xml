<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <persistence-unit name="llmsysmon">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <class>dev.felicityiris.llmsysmon.database.MetricEntity</class>
        
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:llmsysmon.db"/>
            
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>